# Gemini API Key (Required for AI generation)
# Obtain your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini model: gemini-3.7-flash (fast & agentic) or gemini-2.5-pro (deep reasoning)
GEMINI_MODEL=gemini-3.7-flash

# Optional: Server configuration
PORT=5000
HOST=127.0.0.1
DEBUG=True

